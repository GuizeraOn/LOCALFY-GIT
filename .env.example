# Conexão com o Supabase
NEXT_PUBLIC_SUPABASE_URL=sua-url-supabase-aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Integração com o Facebook Ads
FB_ACCESS_TOKEN=sua-chave-aqui
FB_AD_ACCOUNT_ID=seu-id-de-conta-aqui

# Configurações do App
NEXT_PUBLIC_PLATFORM_FEE=0.13

# Hotmart — webhook de vendas (recebido em POST /api/webhook/hotmart)
HOTMART_WEBHOOK_TOKEN=sua-chave-de-webhook-aqui

# Hotmart — importação de histórico (usado em POST /api/sync/hotmart)
# Obtido em: Hotmart -> Ferramentas -> Credenciais de API (Access Token / Personal Access Token)
# Cole apenas em .env.local — nunca commite este valor no repositório
HOTMART_ACCESS_TOKEN=sua-chave-aqui
